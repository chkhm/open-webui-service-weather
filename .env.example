# Copy this file to .env and fill in your OpenWeather API key.
#   cp .env.example .env
#
# .env is gitignored - never commit your real key.
# Get a key at https://openweathermap.org/api (free tier is sufficient).
OWM_API_KEY=

# Where the model runs. Set exactly one of the two:
#   a Linux box with an NVIDIA GPU: start the ollama container
# COMPOSE_PROFILES=gpu
#   Ollama installed natively on this host (a Mac, for instance): no container
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# On a Linux host a native Ollama must listen on all interfaces: OLLAMA_HOST=0.0.0.0.
# macOS with Docker Desktop needs nothing extra.

# Open WebUI log level; DEBUG shows which tools each chat request carried
# GLOBAL_LOG_LEVEL=INFO

# Model used by scripts/e2e-tool-call.sh unless --model is given
# E2E_MODEL=gpt-oss:120b
